#!/usr/bin/env bash

# Conversion fichier gift en HTML, pour visualisation rapide
# S. Kramm - 10/2026

if [ -z "$1" ]; then
	echo "Argument (nom fichier gift à traiter) manquant!"
	exit 1
fi

if ! [ -f "$1" ]; then
	echo "Fichier $1 introuvable!"
	exit 1
fi

IN=$1
OUT="${IN%.*}.html"

if [ -f "$OUT" ]; then
	read -p "Fichier $OUT existe, ok pour le remplacer? (O/N) " ans
	if [ "$ans" != "O" ] && [ "$ans" != "o" ] ; then
		echo "annulation"
		exit 1
	fi
fi

echo "<html><head>" >$OUT
echo "<style>" >>$OUT
echo "pre { border: black 1px solid; font-size:150%;" >>$OUT
echo "padding: 1em; margin; 1em;}" >>$OUT

echo "</style>" >>$OUT
echo "</head><body>" >>$OUT

# currently handling a question
CURRENT=N

# currently in the "question" section
SECT_Q=N

# currently in the "answer" section
SECT_A=N

# this is special "control" line ({}), do not print it
SPECIAL=N

# We already closed (</div>) the question
ISCLOSED=N

ID=0
while read LINE
do
# si la ligne est vide
	if [ ${#LINE} == 0 ]; then
		CURRENT=N
		if [ "$ISCLOSED" = "N" ]; then # fin de la question
				echo "</div>" >>$OUT
				ISCLOSED=Y
		fi
		echo "" >>$OUT
	fi
	SPECIAL=N

# si c'est l'entete d'une question
	if [ "${LINE:0:2}" == "::" ]; then
		IDX=$ID
		if [ ${#ID} == 1 ]; then IDX=0$ID; fi
		echo "<hr><div><h2>question $IDX</h2>" >>$OUT
		((ID++))
		CURRENT=Y
		SECT_Q=Y
		SPECIAL=Y
		ISCLOSED=N
	fi

# début de la partie "réponses"
	if [ "${LINE:0:1}" == "{" ]; then
		SECT_Q=N
		SECT_A=Y
		SPECIAL=Y
		FIRSTSECT_A=Y
#		echo "debut réponses"
	fi

# fin des réponses
	if [ "${LINE:0:1}" == "}" ]; then
		SPECIAL=N
		SECT_A=N
		CURRENT=Y
#		echo "fin réponses"
		echo "</ol>" >>$OUT
	fi


	if [ $SPECIAL = N ] && [ $SECT_A = Y ]; then
		if [ $FIRSTSECT_A = Y ]; then
			echo "<h3>Réponses:</h3><ol>" >>$OUT
			FIRSTSECT_A=N
		fi
		if [ "${LINE:0:1}" = "=" ]; then
			LI2=${LINE#"="}
			echo "<li>✅: $LI2</li>" >>$OUT
		fi
		if [ "${LINE:0:1}" = "~" ]; then
			LI2=${LINE#"~"}
			echo "<li>❌: $LI2</li>" >>$OUT
		fi
	fi

	if [ $SECT_Q = Y ] && [ $SPECIAL = N ]; then
		echo "$LINE" >>$OUT
	fi

done < "$IN"

echo "-Terminé, $ID questions trouvées, fichier de sortie=$OUT"

echo "</body></html>" >>$OUT


